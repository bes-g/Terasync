# Node Environment
NODE_ENV=development
PORT=4000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terasync?schema=public

# Cache & Queues (Redis 7)
REDIS_URL=redis://localhost:6379

# Authentication Secrets
JWT_ACCESS_SECRET=replace_with_a_secure_jwt_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=replace_with_a_secure_jwt_refresh_secret_min_32_chars_long

# Security / PIN Handshake Secret (HMAC-SHA256)
PIN_HMAC_SECRET=replace_with_a_secure_hmac_secret_min_32_chars_long

# Email Provider Configuration (console in dev, smtp in prod)
EMAIL_PROVIDER=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM_NAME=TeraSync
EMAIL_FROM_ADDRESS=no-reply@terasync.et

# Initial Admin Seed
ADMIN_EMAIL=admin@terasync.et
ADMIN_PASSWORD=Admin@TeraSync2026!
ADMIN_NAME=TeraSync SuperAdmin